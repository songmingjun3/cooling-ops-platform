# ---------- 构建产物 ----------
target/
out/
build/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# ---------- 运行时数据 ----------
# SQLite 数据库文件（运行时自动创建，不纳入版本管理；data/.gitkeep 保留目录本身）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 运行日志（logs/.gitkeep 保留目录本身）
logs/*
!logs/.gitkeep
*.log

# 导出文件
export/
*.csv

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
*.launch

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 其他 ----------
*.tmp
*.bak
*.orig
~$*
